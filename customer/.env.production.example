VITE_API_URL=https://dd-mystery-production.up.railway.app
# Cashfree checkout mode: PRODUCTION or SANDBOX (must match the backend CASHFREE_ENV)
VITE_CASHFREE_ENV=PRODUCTION
# Optional Google sign-in client ID (same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
# Set to true to show the maintenance page to customers
VITE_MAINTENANCE_MODE=false
