# Copy these keys into Railway's backend service Variables.
# Never commit real credentials or the populated .env file.
NODE_ENV=production
# In Railway, set MONGO_URI to the connection string only (no MONGO_URI= prefix or quotes).
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/dd_mystery_box?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_new_random_secret
JWT_EXPIRES_IN=30d
CLIENT_URL=https://ddmarket.shop
CORS_ORIGINS=https://ddmarket.shop,https://www.ddmarket.shop,https://dd-mystery.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:3000
CRON_SECRET=replace_with_a_new_random_value_if_using_scheduled_cleanup

# Optional Google sign-in
GOOGLE_CLIENT_ID=

# Cashfree payment credentials; retain the environment matching your account.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# Optional product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin bootstrap credentials; do not use these to reset an existing account.
ADMIN_NAME=DD Mystery Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_DESTRUCTIVE_SEED=false

# Email: API credentials are preferred; SMTP credentials are fallback.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DD Mystery Box
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Fast2SMS notifications
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
