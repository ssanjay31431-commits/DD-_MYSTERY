# Railway supplies PORT. Set this only for local development.
PORT=5000
# Set NODE_ENV=production in Railway.
MONGO_URI=mongodb://127.0.0.1:27017/dd_mystery_box
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173
# Railway production: CLIENT_URL=https://dd-mystery.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CRON_SECRET=replace_with_a_long_random_value

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cashfree API Credentials (PRODUCTION or TEST Environment)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=PRODUCTION  # Set to PRODUCTION for live payments, or TEST for sandbox
CASHFREE_API_VERSION=2023-08-01

# Cloudinary Credentials (Optional in Dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed Admin Credentials
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_DESTRUCTIVE_SEED=false

# Brevo Transactional Email Credentials
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Brevo SMTP fallback credentials
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASS=your_brevo_smtp_password

# SMS Provider Credentials (Fast2SMS)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here
