PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dd_mystery_box
JWT_SECRET=dd_mystery_box_jwt_secret_key_change_in_production_2026
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cashfree API Credentials (TEST / SANDBOX Environment)
CASHFREE_CLIENT_ID=PASTE_CLIENT_ID_HERE
CASHFREE_CLIENT_SECRET=PASTE_SECRET_KEY_HERE
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# Cloudinary Credentials (Optional in Dev)
CLOUDINARY_CLOUD_NAME=ddmysterybox
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz1

# Seed Admin Credentials
ADMIN_NAME=DD Mystery Admin
ADMIN_EMAIL=admin@ddmysterybox.com
ADMIN_PASSWORD=Admin@123456

# Brevo Transactional Email Credentials
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# Email transport. Options: brevo-api, smtp
EMAIL_PROVIDER=brevo-api

# Brevo SMTP fallback credentials (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASS=your_brevo_smtp_password

# SMS Provider Credentials (Fast2SMS)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here
